{
  "private": true,
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.0",
    "esbuild": "^0.25.5",
    "node-forge": "^1.3.1",
    "parcel": "^2.16.0",
    "purescript": "^0.15.15",
    "uuid-validate": "^0.0.3"
  },
  "scripts": {
    "build": "spago build",
    "copy-assets": "ln -sf ../dev/assets ./dist/",
    "serve": "npm run copy-assets && parcel dev/index.html --open",
    "build-parcel": "mkdir -p dist && cp dev/index.html dist/ && ln -sf ../dev/assets dist/assets && spago bundle --bundle-type app --outfile dist/index.js && parcel build dist/index.html --public-url /app/"
  },
  "dependencies": {
    "big-integer": "^1.6.48",
    "purty": "^7.0.0",
    "qrious": "^4.0.2",
    "spago": "^0.93.44",
    "uuid": "^11.1.0",
    "uuid-validate": "0.0.3"
  },
  "overrides": {
    "tar": "^7.5.6"
  }
}
